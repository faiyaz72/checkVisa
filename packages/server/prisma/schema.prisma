// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// SIMPLIFIED SCHEMA
// ============================================

model CountryInfo {
  countryCd String @id

  originRequirements      VisaRequirement[] @relation("OriginCountry")
  destinationRequirements VisaRequirement[] @relation("DestinationCountry")
}

model VisaRequirement {
  id String @id @default(cuid())

  // Country codes
  originCountryCode      String
  destinationCountryCode String

  originCountry      CountryInfo @relation("OriginCountry", fields: [originCountryCode], references: [countryCd])
  destinationCountry CountryInfo @relation("DestinationCountry", fields: [destinationCountryCode], references: [countryCd])

  // Core visa information
  primaryRequirement String // VISA_FREE, VISA_REQUIRED, etc.
  duration           Json? // { maxStayDays: 180, description: "..." }

  // Metadata
  sourceUrl    String?
  lastVerified DateTime?
  notesHash    String?

  // Relations
  conditions VisaCondition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([originCountryCode, destinationCountryCode])
  @@index([originCountryCode])
  @@index([destinationCountryCode])
  @@index([primaryRequirement])
}

model VisaCondition {
  id String @id @default(cuid())

  // Relation
  visaRequirementId String
  visaRequirement   VisaRequirement @relation(fields: [visaRequirementId], references: [id], onDelete: Cascade)

  // Condition details
  type              String // REQUIRES_VISA, REQUIRES_RESIDENCY, etc.
  description       String // Full explanation
  acceptedCountries String[] // ["US", "CA", "UK", "SCHENGEN"]

  // Common rules
  mustBeValid   Boolean @default(true)
  durationIfMet Json? // { maxStayDays: 30 }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visaRequirementId])
  @@index([acceptedCountries]) // For filtering "I have X visa"
}
